# Pick ONE provider. Gemini has a genuinely free tier - get a key in ~90s at
# https://aistudio.google.com/apikey   (no credit card required)
LLM_PROVIDER=gemini

GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash

# Fallback: Groq (also free) - https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional, paid, highest quality - https://console.anthropic.com
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
